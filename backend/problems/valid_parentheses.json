{
    "id": "valid_parentheses",
    "title": "Valid Parentheses",
    "difficulty": "Easy",
    "tags": [
        "Stack",
        "String"
    ],
    "description": "Given a string s containing only the characters '(', ')', '{', '}', '[' and ']', return true if the input string is valid. A string is valid if open brackets are closed by the same type of brackets and in the correct order.",
    "function_name": "is_valid",
    "starter_code": "def is_valid(s):\n    pass",
    "examples": [
        {
            "input": "s = \"()\"",
            "output": "True",
            "explanation": "The opening parenthesis is closed correctly."
        },
        {
            "input": "s = \"([{}])\"",
            "output": "True",
            "explanation": "All brackets are closed in the correct order."
        },
        {
            "input": "s = \"(]\"",
            "output": "False",
            "explanation": "The opening parenthesis is closed by the wrong bracket type."
        }
    ],
    "visible_tests": [
        {
            "input": {
                "s": "()"
            },
            "expected": true
        },
        {
            "input": {
                "s": "([{}])"
            },
            "expected": true
        },
        {
            "input": {
                "s": "(]"
            },
            "expected": false
        }
    ],
    "hidden_tests": [
        {
            "input": {
                "s": "([)]"
            },
            "expected": false
        },
        {
            "input": {
                "s": "{[]}"
            },
            "expected": true
        }
    ]
}